NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site, utilisée pour metadataBase, les URL canoniques, le
# sitemap, robots.txt et les images Open Graph/Twitter (voir src/lib/site.ts).
# Optionnelle : absente, repli sur https://zendou.kingreys.fr (domaine de
# bêta tranché par le porteur le 12/08/2026, docs/plans/BACKLOG.md fiche B8).
# ⚠️ Comme NEXT_PUBLIC_API_URL, figée au build — changer de domaine impose un
# rebuild de l'image (voir frontend/Dockerfile et
# docs/DEPLOIEMENT-DOKPLOY.md §5.2).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Captcha Cloudflare Turnstile sur /inscription. Optionnelle : absente, aucun
# widget n'est rendu et l'inscription fonctionne comme sans captcha. Valeur
# ci-dessous = clé de site de test officielle Cloudflare ("toujours valide"),
# utilisable sans compte Cloudflare — à remplacer par une vraie clé de site
# en production (le backend doit alors avoir TURNSTILE_SECRET_KEY assortie).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# URL de l'API vue depuis le serveur Next, utilisee par src/proxy.ts pour
# valider la session (GET /v1/auth/me) avant de rendre une page privee.
# Cote serveur uniquement (pas de prefixe NEXT_PUBLIC_) : elle n'est jamais
# envoyee au navigateur et, contrairement a NEXT_PUBLIC_API_URL, elle est lue
# a l'execution, donc modifiable sans rebuild de l'image.
# Optionnelle : absente ou vide, le proxy retombe sur NEXT_PUBLIC_API_URL.
# Interet : dans le reseau Dokploy, viser le conteneur backend directement
# (http://backend:4000) evite un aller-retour par Internet et le TLS public.
# API_INTERNAL_URL=http://backend:4000
